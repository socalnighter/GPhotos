{
  "manifest_version": 3,
  "name": "GPhotos Backup",
  "version": "1.1.0",
  "description": "Back up your Google Photos library to a folder on your computer or drive, sorted by year, month or your own custom pattern.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "power"
  ],
  "host_permissions": [
    "https://photos.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*"
  ],
  "action": {
    "default_title": "Back up Google Photos to a folder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://photos.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
